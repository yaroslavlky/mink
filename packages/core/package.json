{
  "name": "@yaroslavlky/mink-core",
  "version": "0.9.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./schema/mink.schema.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node24 --platform node --dts --out-dir dist --clean && node ../../scripts/prepare-package.mjs core",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate-types": "json2ts schema/mink.schema.json -o src/types/schema.d.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "consola": "^3.4.2",
    "fuse.js": "^7.5.0",
    "js-yaml": "^5.4.2",
    "tinyglobby": "^0.2.15",
    "proper-lockfile": "^4.1.2",
    "cross-spawn": "^7.0.6",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "json-schema-to-typescript": "^16.0.0",
    "tsup": "^8.5.1",
    "@types/proper-lockfile": "^4.1.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "schema",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaroslavlky/mink.git",
    "directory": "packages/core"
  },
  "homepage": "https://yaroslavlky.github.io/mink/",
  "bugs": {
    "url": "https://github.com/yaroslavlky/mink/issues"
  },
  "description": "Portable execution engine for Mink repository tasks and services"
}
