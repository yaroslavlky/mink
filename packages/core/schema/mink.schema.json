{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mink configuration",
  "type": "object",
  "required": ["version", "commands"],
  "properties": {
    "version": {
      "const": 1
    },
    "includes": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["path", "namespace"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "namespace": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "repository": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "properties": {
        "ttl_ms": { "type": "integer", "minimum": 0 },
        "max_size_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "remote_cache": {
      "type": "object",
      "required": ["provider", "url"],
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "provider": { "enum": ["http", "s3"] },
        "url": { "type": "string", "minLength": 1 },
        "token_env": { "type": "string", "minLength": 1 },
        "signing_key_env": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "vars": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "env_file": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "vars": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "boolean"] }
          },
          "env_file": { "$ref": "#/$defs/envFile" },
          "commands": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/commandOverlay" }
          }
        },
        "additionalProperties": false
      }
    },
    "commands": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/command"
          },
          {
            "$ref": "#/$defs/pipeline"
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "envFile": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "commandOverlay": {
      "type": "object",
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exec": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 },
        "disabled": { "type": "boolean" },
        "vars": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "oneOf": [
        {
          "required": ["package_script"]
        },
        {
          "required": ["shell_script"]
        }
      ],
      "properties": {
        "package_script": {
          "type": "object",
          "required": ["manifest", "name"],
          "properties": {
            "manifest": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "shell_script": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "dependency": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "condition": {
              "enum": ["started", "healthy", "completed_successfully", "failed"]
            },
            "optional": { "type": "boolean" },
            "if": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "parameter": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["string", "boolean", "number", "select", "port", "path", "secret"]
        },
        "description": {
          "type": "string"
        },
        "default": {},
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "options_from": {
          "type": "object",
          "required": ["exec"],
          "properties": { "exec": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        },
        "required": { "type": "boolean" },
        "regex": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": ["string", "number", "boolean"] }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lock": { "type": "string", "minLength": 1 },
        "positional": { "type": "boolean" },
        "variadic": { "type": "boolean" },
        "env": {
          "type": "string",
          "minLength": 1
        },
        "flag": {
          "type": "string",
          "pattern": "^--?[A-Za-z0-9][A-Za-z0-9-]*$"
        },
        "when": {
          "type": "object",
          "required": ["param", "equals"],
          "properties": {
            "param": {
              "type": "string",
              "minLength": 1
            },
            "equals": {
              "type": ["string", "number", "boolean"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["string", "path"]
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "string"
              }
            },
            "not": {
              "required": ["options"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            },
            "not": {
              "required": ["options"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["number", "port"]
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "number"
              }
            },
            "not": {
              "required": ["options"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "anyOf": [{ "required": ["options"] }, { "required": ["options_from"] }],
            "properties": {
              "default": {
                "type": "string"
              }
            },
            "not": { "required": ["options", "options_from"] }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "secret"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["default"]
                },
                {
                  "required": ["options"]
                },
                {
                  "required": ["flag"]
                }
              ]
            }
          }
        }
      ]
    },
    "commandParameter": {
      "allOf": [
        {
          "$ref": "#/$defs/parameter"
        },
        {
          "not": {
            "type": "object",
            "required": ["env", "flag"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "secret"
              }
            },
            "type": "object"
          },
          "then": {
            "required": ["env"],
            "type": "object"
          }
        }
      ]
    },
    "pipelineParameter": {
      "allOf": [
        {
          "$ref": "#/$defs/parameter"
        },
        {
          "not": {
            "anyOf": [
              {
                "type": "object",
                "required": ["env"]
              },
              {
                "type": "object",
                "required": ["flag"]
              }
            ]
          }
        }
      ]
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/commandParameter"
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["task", "service"]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "startup_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "ready": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["process", "tcp", "http", "command", "log", "file"]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "interval_ms": {
              "type": "integer",
              "minimum": 10
            },
            "command": { "type": "string", "minLength": 1 },
            "log_line": { "type": "string", "minLength": 1 },
            "file": { "type": "string", "minLength": 1 }
          },
          "required": ["type"],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "tcp"
                  }
                }
              },
              "then": {
                "required": ["port"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "http"
                  }
                }
              },
              "then": {
                "required": ["url"]
              }
            },
            {
              "if": { "properties": { "type": { "const": "command" } } },
              "then": { "required": ["command"] }
            },
            {
              "if": { "properties": { "type": { "const": "log" } } },
              "then": { "required": ["log_line"] }
            },
            {
              "if": { "properties": { "type": { "const": "file" } } },
              "then": { "required": ["file"] }
            }
          ]
        },
        "health": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["process", "tcp", "http", "command", "log", "file"]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "interval_ms": {
              "type": "integer",
              "minimum": 10
            },
            "failure_threshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "command": { "type": "string", "minLength": 1 },
            "log_line": { "type": "string", "minLength": 1 },
            "file": { "type": "string", "minLength": 1 }
          },
          "required": ["type"],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "tcp"
                  }
                }
              },
              "then": {
                "required": ["port"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "http"
                  }
                }
              },
              "then": {
                "required": ["url"]
              }
            },
            {
              "if": { "properties": { "type": { "const": "command" } } },
              "then": { "required": ["command"] }
            },
            {
              "if": { "properties": { "type": { "const": "log" } } },
              "then": { "required": ["log_line"] }
            },
            {
              "if": { "properties": { "type": { "const": "file" } } },
              "then": { "required": ["file"] }
            }
          ]
        },
        "restart": {
          "type": "object",
          "properties": {
            "policy": { "enum": ["always", "on_failure", "never", "exit_on_failure"] },
            "max_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "delay_ms": {
              "type": "integer",
              "minimum": 10,
              "maximum": 60000
            },
            "backoff": {
              "type": "number",
              "minimum": 1,
              "maximum": 8
            }
          },
          "additionalProperties": false
        },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 128 },
        "ready_log_line": { "type": "string", "minLength": 1 },
        "shutdown": {
          "type": "object",
          "properties": {
            "signal": { "type": "string", "minLength": 1 },
            "timeout_ms": { "type": "integer", "minimum": 1 },
            "command": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "schedule": {
          "type": "object",
          "properties": {
            "cron": { "type": "string", "minLength": 1 },
            "interval_ms": { "type": "integer", "minimum": 100 }
          },
          "oneOf": [{ "required": ["cron"] }, { "required": ["interval_ms"] }],
          "additionalProperties": false
        },
        "disabled": { "type": "boolean" },
        "notify": {
          "type": "object",
          "properties": {
            "desktop": { "type": "boolean" },
            "webhook": { "type": "string", "pattern": "^https?://" },
            "after_ms": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "retry": {
          "type": "object",
          "required": ["attempts"],
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "delay_ms": {
              "type": "integer",
              "minimum": 10,
              "maximum": 60000
            },
            "backoff": {
              "type": "number",
              "minimum": 1,
              "maximum": 8
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "const": "command"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dependency" }
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "run": {
          "$ref": "#/$defs/run"
        },
        "presets": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean"]
            }
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "exec": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shell": {
          "enum": ["auto", "sh", "bash", "powershell", "pwsh"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "outputs": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            {
              "type": "object",
              "required": ["auto"],
              "properties": { "auto": { "const": true } },
              "additionalProperties": false
            }
          ]
        },
        "cache": {
          "type": "object",
          "properties": {
            "method": { "enum": ["checksum", "timestamp"] }
          },
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "group": { "type": "string", "minLength": 1 },
        "hidden": { "type": "boolean" },
        "private": { "type": "boolean" },
        "internal": { "type": "boolean" },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "disabled": { "type": "boolean" },
        "confirm": { "oneOf": [{ "type": "boolean" }, { "type": "string" }] },
        "prompt": { "type": "string", "minLength": 1 },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lock": { "type": "string", "minLength": 1 },
        "vars": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "windows": { "$ref": "#/$defs/commandOverlay" },
        "linux": { "$ref": "#/$defs/commandOverlay" },
        "darwin": { "$ref": "#/$defs/commandOverlay" }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["command"],
          "not": {
            "required": ["exec"]
          }
        },
        {
          "required": ["exec"],
          "not": {
            "required": ["command"]
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["uses"],
      "properties": {
        "uses": {
          "type": "string",
          "minLength": 1
        },
        "needs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "wait_for": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "with": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "run": { "enum": ["once", "when_changed", "always"] },
        "continue_on_error": { "type": "boolean" },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "lock": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" },
        "if": { "type": "string", "minLength": 1 },
        "for": {
          "type": "object",
          "required": ["var", "values"],
          "properties": {
            "var": { "type": "string", "minLength": 1 },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": { "type": ["string", "number", "boolean"] }
            }
          },
          "additionalProperties": false
        },
        "matrix": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": ["string", "number", "boolean"] }
          }
        }
      },
      "additionalProperties": false
    },
    "pipeline": {
      "type": "object",
      "required": ["kind", "name", "steps"],
      "properties": {
        "kind": {
          "const": "pipeline"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/pipelineParameter"
          }
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/step"
          }
        },
        "presets": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean"]
            }
          }
        },
        "fail_fast": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "group": { "type": "string", "minLength": 1 },
        "hidden": { "type": "boolean" },
        "private": { "type": "boolean" },
        "internal": { "type": "boolean" },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "hooks": {
          "type": "object",
          "properties": {
            "before": { "$ref": "#/$defs/idList" },
            "after": { "$ref": "#/$defs/idList" },
            "on_success": { "$ref": "#/$defs/idList" },
            "on_failure": { "$ref": "#/$defs/idList" },
            "finally": { "$ref": "#/$defs/idList" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "idList": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    }
  }
}
